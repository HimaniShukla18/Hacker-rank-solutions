#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1000000007;

long long substrings(const string &n) {
    long long result = 0;
    long long f = 0;  // cumulative contribution

    for (int i = 0; i < (int)n.size(); i++) {
        int digit = n[i] - '0';
        // Update contribution: each digit contributes based on position
        f = (f * 10 + (long long)(i + 1) * digit) % MOD;
        result = (result + f) % MOD;
    }

    return result;
}

int main() {
    string n;
    cin >> n;

    cout << substrings(n) << endl;
    return 0;
}
