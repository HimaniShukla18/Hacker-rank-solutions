#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int anagram(char *s) {
    int len = strlen(s);
    if (len % 2 != 0) {
        return -1; // Cannot split into two equal halves
    }

    int count1[26] = {0}, count2[26] = {0};
    int mid = len / 2;

    // Count frequency of characters in both halves
    for (int i = 0; i < mid; i++) {
        count1[s[i] - 'a']++;
    }
    for (int i = mid; i < len; i++) {
        count2[s[i] - 'a']++;
    }

    // Count how many characters in first half need to be changed
    int changes = 0;
    for (int i = 0; i < 26; i++) {
        if (count1[i] > count2[i]) {
            changes += count1[i] - count2[i];
        }
    }

    return changes;
}

int main() {
    int t;
    scanf("%d", &t);
    char s[10001];

    while (t--) {
        scanf("%s", s);
        printf("%d\n", anagram(s));
    }

    return 0;
}
